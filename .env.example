# Database (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/dermacare?schema=public"

# Redis & BullMQ (Upstash / Local)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_URL="redis://default:@localhost:6379"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Razorpay Payment Gateway (India)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Telemedicine - Google Meet (Google Cloud Calendar Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID="primary"

# Telemedicine - Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Telemedicine - WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Private S3-Compatible Storage (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET_NAME="dermacare-clinical-records"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Application URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=4000

